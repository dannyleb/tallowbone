[layer_names]

2d_physics/layer_1="stone"
2d_physics/layer_2="walkways"
2d_physics/layer_3="player"
2d_physics/layer_4="enemies"

[physics]

common/physics_ticks_per_second=60
; When frames run slow, catch up at most this many physics ticks per frame:
; past that the game slows down instead of spiralling into a freeze.
common/max_physics_steps_per_frame=3

[rendering]

; Desktop draws the full 3D stage (shadows, volumetric fog, reflections);
; the web gets the lighter renderer and a reduced version of it.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
; Apple Silicon (the Mac build) needs this texture format available.
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.027, 0.031, 0.051, 1)
; The browser: a smaller moon-shadow map with hard edges, cheaper glow.
lights_and_shadows/directional_shadow/size.web=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=0
environment/glow/upscale_mode.web=0
; The volumetric fog's grid: coarser than the default (it's soft anyway).
environment/volumetric_fog/volume_size=48
environment/volumetric_fog/volume_depth=48
; Bounce light is a soft wash in the dark here: low quality is plenty.
environment/ssil/quality=1
environment/ssil/blur_passes=3

[importer_defaults]

texture={
"mipmaps/generate": true
}
